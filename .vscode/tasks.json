{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test: all",
      "type": "shell",
      "command": "bash scripts/test.sh",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "web: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "web: test",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/web",
        "env": { "CI": "1", "NO_COLOR": "1", "FORCE_COLOR": "0" }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "web: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/web",
        "env": { "CI": "1", "NO_COLOR": "1", "FORCE_COLOR": "0" }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "go: test",
      "type": "shell",
      "command": "go test ./...",
      "group": "test",
      "problemMatcher": "$go"
    }
  ]
}
